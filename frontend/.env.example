# ── Frontend (Next.js) ──────────────────────────────────────────────

# Production API base URL including /api suffix (Vercel / live site)
NEXT_PUBLIC_API_URL=https://api.clinkaeng.com/api

# Local backend origin (no /api suffix) — used by `next dev` proxy, sockets, Google OAuth
BACKEND_URL=http://localhost:5000
NEXT_PUBLIC_BACKEND_URL=http://localhost:5000

# Payment currency shown in the UI (must match backend PAYMOB_CURRENCY)
NEXT_PUBLIC_PAYMENT_CURRENCY=USD

# ── How it works ────────────────────────────────────────────────────
# `npm run dev` (localhost:3000):
#   - API calls go to /api → proxied to BACKEND_URL (avoids CORS/cookie issues)
#   - Sockets + Google OAuth hit BACKEND_URL directly
#
# Production build (clinkaeng.com):
#   - API calls use NEXT_PUBLIC_API_URL (https://api.clinkaeng.com/api)
