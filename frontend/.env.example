# ── Frontend (Next.js) ──────────────────────────────────────────────
# Public API base URL including /api suffix (set at build time on Vercel)
NEXT_PUBLIC_API_URL=https://api.clinkaeng.com/api

# Payment currency shown in the UI (must match backend PAYMOB_CURRENCY)
NEXT_PUBLIC_PAYMENT_CURRENCY=EGP
