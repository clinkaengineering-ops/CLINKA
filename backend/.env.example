PORT = 5000
DATABASE_URL = 
JWT_SECRET = your_jwt_secret_key
JWT_EXPIRES_IN = 1d
EMAIL_HOST = smtp.example.com
EMAIL_PORT = 587
EMAIL_USER =
EMAIL_PASS = your_email_password
CLOUDINARY_CLOUD_NAME = your_cloudinary_cloud_name
CLOUDINARY_API_KEY = your_cloudinary_api_key
CLOUDINARY_API_SECRET = your_cloudinary_api_secret
CLIENT_URL = http://localhost:3000
API_URL = http://localhost:5000

# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID =
GOOGLE_CLIENT_SECRET =
# Must match Authorized redirect URI in Google Cloud (defaults to API_URL + /api/auth/google/callback)
GOOGLE_REDIRECT_URI = http://localhost:5000/api/auth/google/callback

# Fawaterk payment gateway (https://fawaterak-api.readme.io)
# Staging: https://staging.fawaterk.com/api/v2  |  Live: https://app.fawaterk.com/api/v2
FAWATERK_API_BASE_URL=https://app.fawaterk.com/api/v2
FAWATERK_API_TOKEN=
FAWATERK_VENDOR_KEY=
FAWATERK_CURRENCY=EGP
PLATFORM_COMMISSION_RATE=0.1
FAWATERK_DEV_FALLBACK=true

