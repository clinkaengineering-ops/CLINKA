PORT = 5000
# Local dev: run `npm run db:up` then use this URL (matches docker-compose.yml)
DATABASE_URL = postgresql://mohamedtalal@localhost:5432/clinka
JWT_SECRET = your_jwt_secret_key
JWT_EXPIRES_IN = 1d
EMAIL_HOST = smtp.example.com
EMAIL_PORT = 587
EMAIL_USER =
EMAIL_PASS = your_email_password
CLOUDINARY_CLOUD_NAME = your_cloudinary_cloud_name
CLOUDINARY_API_KEY = your_cloudinary_api_key
CLOUDINARY_API_SECRET = your_cloudinary_api_secret
CLIENT_URL = http://localhost:3000
API_URL = http://localhost:5000

# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID =
GOOGLE_CLIENT_SECRET =
# Must match Authorized redirect URI in Google Cloud (defaults to API_URL + /api/auth/google/callback)
GOOGLE_REDIRECT_URI = http://localhost:5000/api/auth/google/callback

# Paymob payment gateway (https://developers.paymob.com)
# Egypt: https://accept.paymob.com  |  KSA: https://ksa.paymob.com
PAYMOB_BASE_URL=https://accept.paymob.com
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_HMAC_SECRET=
PAYMOB_INTEGRATION_IDS=
PAYMOB_CURRENCY=EGP
PLATFORM_COMMISSION_RATE=0.1
PAYMOB_DEV_FALLBACK=true

# Help center contact (shown on /help and used for mailto links)
SUPPORT_EMAIL=support@clinka.com
