PORT=5000
NODE_ENV=production

# PostgreSQL — use a managed provider (Neon, Supabase, Render Postgres, etc.)
DATABASE_URL=postgresql://user:password@host:5432/clinka

JWT_SECRET=your_long_random_jwt_secret
JWT_EXPIRES_IN=1d

EMAIL_USER=
RESEND_API_KEY=

CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Frontend URL (browser app) — used for CORS, cookies, and redirects
CLIENT_URL=https://clinkaeng.com
# Optional: canonical public URL for emails when CLIENT_URL differs (e.g. preview deploys)
# PUBLIC_CLIENT_URL=https://clinkaeng.com

# Public API URL — must be reachable from the internet (Paymob webhooks, Google OAuth callback)
API_URL=https://api.clinkaeng.com
# Optional comma-separated extra CORS origins
# CORS_EXTRA_ORIGINS=

# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.clinkaeng.com/api/auth/google/callback

# Paymob payment gateway (https://developers.paymob.com)
# Egypt: https://accept.paymob.com  |  KSA: https://ksa.paymob.com
PAYMOB_BASE_URL=https://accept.paymob.com
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_API_KEY=
PAYMOB_HMAC_SECRET=
PAYMOB_INTEGRATION_IDS=
PAYMOB_CURRENCY=EGP
PLATFORM_COMMISSION_RATE=0.1

# Paymob Payouts / auto-withdrawals (https://payouts.paymobsolutions.com/docs/)
PAYMOB_PAYOUT_BASE_URL=https://payouts.paymobsolutions.com/api/secure
PAYMOB_PAYOUT_CLIENT_ID=
PAYMOB_PAYOUT_CLIENT_SECRET=
PAYMOB_PAYOUT_USERNAME=
PAYMOB_PAYOUT_PASSWORD=
PAYMOB_PAYOUT_INSTANT_BANK_MIN=112

# Redis — OAuth OTP cache and payout token cache
REDIS_URL=redis://user:password@host:6379

# Help center contact (shown on /help and used for mailto links)
SUPPORT_EMAIL=support@clinka.com

# Paymob dashboard (per integration) — base paths only, no query params:
#   Redirect URL:  {CLIENT_URL}/checkout
#   Webhook URL:   {API_URL}/api/payments/webhook/paymob

# ── Local development defaults (copy to .env.local and adjust) ─────────────
# NODE_ENV=development
# CLIENT_URL=http://localhost:3000
# API_URL=http://localhost:5000
# GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback
# See .env.local.example
