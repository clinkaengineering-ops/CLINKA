// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// DATABASE_URL is configured in prisma.config.ts (Prisma 7)
datasource db {
  provider = "postgresql"
}

enum Role {
CLIENT
ENGINEER
ADMIN
}

enum EngineerSpecialty {
CIVIL
ARCHITECTURAL
}

enum ServiceType{
DESIGN
SUPERVISION
REVIEW
}

enum ProjectStatus {
  OPEN
  IN_PROGRESS
  AWAITING_APPROVAL
  SUBMITTED_FOR_REVIEW
  REVISION_REQUESTED
  COMPLETED
  CANCELLED
}

enum DeliverableType {
  FILE
  LINK
}

enum PaymentLedgerType {
  FUNDED
  ENGINEER_ESCROW
  PLATFORM_COMMISSION
  RELEASED
  REFUNDED
}

enum BidStatus{
PENDING
ACCEPTED
REJECTED
}

enum PaymentStatus{
PENDING
FUNDED
RELEASED
REFUNDED
}

enum VerificationStatus{
PENDING
APPROVED
REJECTED
}

enum BanReason {
  CONTACT_INFO_SHARING
  MANUAL_BAN
}

enum SupportTicketStatus {
  OPEN
  SOLVED
  UNRESOLVED
}

enum WalletTransactionType {
  PROJECT_PAYMENT
  RELEASED
  WITHDRAWAL
}

enum WalletTransactionStatus {
  PENDING
  AVAILABLE
  COMPLETED
  REJECTED
}

enum WithdrawalRequestStatus {
  PENDING
  PROCESSING
  COMPLETED
  REJECTED
}

model User {
id Int @id @default(autoincrement())
name String
email String @unique
password String
googleId String? @unique
role Role @default(CLIENT)
isVerified Boolean @default(false)
avatarUrl String?
notificationPrefs Json?
createdAt DateTime @default(now())
updatedAt DateTime @updatedAt

profile EngineerProfile?
projects Project[]
reviews Review[]
messages Message[]
notifications Notification[]
clientConversations Conversation[] @relation("ClientConversations")
engineerConversations Conversation[] @relation("EngineerConversations")
ban         Ban?
bannedBans  Ban[]  @relation("BannedByAdmin")

clientPayments   Payment[] @relation("ClientPayments")
supportTickets   SupportTicket[] @relation("UserSupportTickets")
resolvedTickets  SupportTicket[] @relation("ResolvedSupportTickets")
wallet           Wallet?
withdrawalRequests WithdrawalRequest[]

}

model Ban {
  id          Int       @id @default(autoincrement())
  userId      Int       @unique
  reason      BanReason
  bannedAt    DateTime  @default(now())
  expiresAt   DateTime
  bannedById      Int?
  note            String?
  triggerMessage  String?
  active          Boolean   @default(true)

  user     User  @relation(fields: [userId], references: [id])
  bannedBy User? @relation("BannedByAdmin", fields: [bannedById], references: [id])
}
model EngineerProfile {
  id                 Int                @id @default(autoincrement())
  userId             Int                @unique
  specialty          EngineerSpecialty
  nationality        String?
  bio                String?
  coverImageUrl      String?
  verificationStatus VerificationStatus @default(PENDING)

  collegeIdUrl     String?
  certificateUrl   String?
  syndicateCardUrl String?

  averageRating      Float              @default(0)
  totalReviews       Int                @default(0)
  createdAt          DateTime           @default(now())

  user User @relation(fields:[userId], references:[id])
  engineerPayments Payment[] @relation("EngineerPayments")

  portfolio PortfolioItem[]
  bids      Bid[]
  reviews   Review[]
}

model PortfolioItem {
  id          Int             @id @default(autoincrement())
  engineerId  Int
  imageUrl    String
  description String
  createdAt   DateTime        @default(now())

  engineer    EngineerProfile @relation(fields: [engineerId], references: [id])
}

model Project {
  id          Int           @id @default(autoincrement())
  clientId    Int
  title       String
  description String
  budget      Float
  serviceType ServiceType
  status      ProjectStatus @default(OPEN)
  progressNote String?
  progressUpdatedAt DateTime?
  isFlagged   Boolean       @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  client       User          @relation(fields: [clientId], references: [id])
  bids         Bid[]
  payment      Payment?
  conversation Conversation?
  review       Review?
  submissions  ProjectSubmission[]
}

model Bid {
  id          Int       @id @default(autoincrement())
  projectId   Int
  engineerId  Int
  price       Float
  duration    String
  description String
  status      BidStatus @default(PENDING)
  createdAt   DateTime  @default(now())

  project  Project         @relation(fields: [projectId], references: [id])
  engineer EngineerProfile @relation(fields: [engineerId], references: [id])
}

model Payment {
  id                 Int           @id @default(autoincrement())
  projectId          Int           @unique
  clientId           Int
  engineerId         Int
  amount             Float
  commission         Float
  gatewayInvoiceId   String?
  gatewayInvoiceKey  String?
  status             PaymentStatus @default(PENDING)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  project    Project         @relation(fields: [projectId], references: [id])
  client     User            @relation("ClientPayments",   fields: [clientId],   references: [id])
  engineer   EngineerProfile @relation("EngineerPayments", fields: [engineerId], references: [id])
  ledgerEntries PaymentLedgerEntry[]
}

model PaymentLedgerEntry {
  id        Int               @id @default(autoincrement())
  paymentId Int
  type      PaymentLedgerType
  amount    Float
  note      String?
  createdAt DateTime          @default(now())

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
}

model ProjectSubmission {
  id           Int      @id @default(autoincrement())
  projectId    Int
  engineerId   Int
  notes        String?
  revisionNote String?
  createdAt    DateTime @default(now())

  project      Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  deliverables ProjectDeliverable[]
}

model ProjectDeliverable {
  id           Int             @id @default(autoincrement())
  submissionId Int
  type         DeliverableType
  url          String
  name         String?
  mimeType     String?
  createdAt    DateTime        @default(now())

  submission ProjectSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  type      String
  title     String
  body      String?
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Conversation {
  id                 Int       @id @default(autoincrement())
  projectId          Int       @unique
  clientId           Int
  engineerId         Int
  clientLastReadAt   DateTime?
  engineerLastReadAt DateTime?
  createdAt          DateTime  @default(now())

  project  Project  @relation(fields: [projectId], references: [id])
  client   User     @relation("ClientConversations", fields: [clientId], references: [id])
  engineer User     @relation("EngineerConversations", fields: [engineerId], references: [id])
  messages Message[]
}

model Message {
  id             Int      @id @default(autoincrement())
  conversationId Int
  senderId       Int
  content        String   @default("")
  attachmentUrl  String?
  attachmentName String?
  attachmentMime String?
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id])
  sender       User         @relation(fields: [senderId], references: [id])
}

model Review {
  id         Int      @id @default(autoincrement())
  projectId  Int      @unique
  clientId   Int
  engineerId Int
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())

  project  Project         @relation(fields: [projectId], references: [id])
  engineer EngineerProfile @relation(fields: [engineerId], references: [id])
  client   User            @relation(fields: [clientId], references: [id])
}

model PlatformSettings {
  id                 Int      @id @default(autoincrement())
  platformFeePercent Float    @default(10.0)
  updatedAt          DateTime @updatedAt
}

model SupportTicket {
  id          Int                 @id @default(autoincrement())
  name        String
  email       String
  subject     String
  message     String
  status      SupportTicketStatus @default(OPEN)
  solution    String?
  userId      Int?
  resolvedById Int?
  resolvedAt  DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  user       User? @relation("UserSupportTickets", fields: [userId], references: [id])
  resolvedBy User? @relation("ResolvedSupportTickets", fields: [resolvedById], references: [id])
}

model Wallet {
  id              Int      @id @default(autoincrement())
  userId          Int      @unique
  availableBalance Float   @default(0)
  pendingBalance   Float   @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]
}

model WalletTransaction {
  id                  Int                     @id @default(autoincrement())
  walletId            Int
  amount              Float
  type                WalletTransactionType
  status              WalletTransactionStatus @default(PENDING)
  description         String?
  availableAt         DateTime?
  relatedPaymentId    Int?
  relatedWithdrawalId Int?
  createdAt           DateTime                @default(now())

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
}

model WithdrawalRequest {
  id            Int                     @id @default(autoincrement())
  userId        Int
  amount        Float
  method        String
  accountNumber String
  status        WithdrawalRequestStatus @default(PENDING)
  adminNotes    String?
  processedAt   DateTime?
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}