// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// DATABASE_URL is configured in prisma.config.ts (Prisma 7)
datasource db {
  provider = "postgresql"
}

enum Role {
CLIENT
ENGINEER
ADMIN
}

enum EngineerSpecialty {
CIVIL
ARCHITECTURAL
}

enum ServiceType{
DESIGN
SUPERVISION
REVIEW
}

enum ProjectStatus {
  OPEN
  IN_PROGRESS
  AWAITING_APPROVAL
  COMPLETED
  CANCELLED
}

enum BidStatus{
PENDING
ACCEPTED
REJECTED
}

enum PaymentStatus{
PENDING
FUNDED
RELEASED
REFUNDED
}

enum VerificationStatus{
PENDING
APPROVED
REJECTED
}

enum BanReason {
  CONTACT_INFO_SHARING
  MANUAL_BAN
}

model User {
id Int @id @default(autoincrement())
name String
email String @unique
password String
googleId String? @unique
role Role @default(CLIENT)
isVerified Boolean @default(false)
avatarUrl String?
notificationPrefs Json?
createdAt DateTime @default(now())
updatedAt DateTime @updatedAt

profile EngineerProfile?
projects Project[]
reviews Review[]
messages Message[]
notifications Notification[]
clientConversations Conversation[] @relation("ClientConversations")
engineerConversations Conversation[] @relation("EngineerConversations")
ban         Ban?
bannedBans  Ban[]  @relation("BannedByAdmin")

clientPayments   Payment[] @relation("ClientPayments")

}

model Ban {
  id          Int       @id @default(autoincrement())
  userId      Int       @unique
  reason      BanReason
  bannedAt    DateTime  @default(now())
  expiresAt   DateTime
  bannedById      Int?
  note            String?
  triggerMessage  String?
  active          Boolean   @default(true)

  user     User  @relation(fields: [userId], references: [id])
  bannedBy User? @relation("BannedByAdmin", fields: [bannedById], references: [id])
}
model EngineerProfile {
  id                 Int                @id @default(autoincrement())
  userId             Int                @unique
  specialty          EngineerSpecialty
  bio                String?
  coverImageUrl      String?
  verificationStatus VerificationStatus @default(PENDING)

  collegeIdUrl     String?
  certificateUrl   String?
  syndicateCardUrl String?

  averageRating      Float              @default(0)
  totalReviews       Int                @default(0)
  createdAt          DateTime           @default(now())

  user User @relation(fields:[userId], references:[id])
  engineerPayments Payment[] @relation("EngineerPayments")

  portfolio PortfolioItem[]
  bids      Bid[]
  reviews   Review[]
}

model PortfolioItem {
  id          Int             @id @default(autoincrement())
  engineerId  Int
  imageUrl    String
  description String
  createdAt   DateTime        @default(now())

  engineer    EngineerProfile @relation(fields: [engineerId], references: [id])
}

model Project {
  id          Int           @id @default(autoincrement())
  clientId    Int
  title       String
  description String
  budget      Float
  serviceType ServiceType
  status      ProjectStatus @default(OPEN)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  client       User          @relation(fields: [clientId], references: [id])
  bids         Bid[]
  payment      Payment?
  conversation Conversation?
  review       Review?
}

model Bid {
  id          Int       @id @default(autoincrement())
  projectId   Int
  engineerId  Int
  price       Float
  duration    String
  description String
  status      BidStatus @default(PENDING)
  createdAt   DateTime  @default(now())

  project  Project         @relation(fields: [projectId], references: [id])
  engineer EngineerProfile @relation(fields: [engineerId], references: [id])
}

model Payment {
  id                 Int           @id @default(autoincrement())
  projectId          Int           @unique
  clientId           Int
  engineerId         Int
  amount             Float
  commission         Float
  gatewayInvoiceId   String?
  gatewayInvoiceKey  String?
  status             PaymentStatus @default(PENDING)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  project    Project         @relation(fields: [projectId], references: [id])
  client     User            @relation("ClientPayments",   fields: [clientId],   references: [id])
  engineer   EngineerProfile @relation("EngineerPayments", fields: [engineerId], references: [id])

}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  type      String
  title     String
  body      String?
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Conversation {
  id                 Int       @id @default(autoincrement())
  projectId          Int       @unique
  clientId           Int
  engineerId         Int
  clientLastReadAt   DateTime?
  engineerLastReadAt DateTime?
  createdAt          DateTime  @default(now())

  project  Project  @relation(fields: [projectId], references: [id])
  client   User     @relation("ClientConversations", fields: [clientId], references: [id])
  engineer User     @relation("EngineerConversations", fields: [engineerId], references: [id])
  messages Message[]
}

model Message {
  id             Int      @id @default(autoincrement())
  conversationId Int
  senderId       Int
  content        String   @default("")
  attachmentUrl  String?
  attachmentName String?
  attachmentMime String?
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id])
  sender       User         @relation(fields: [senderId], references: [id])
}

model Review {
  id         Int      @id @default(autoincrement())
  projectId  Int      @unique
  clientId   Int
  engineerId Int
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())

  project  Project         @relation(fields: [projectId], references: [id])
  engineer EngineerProfile @relation(fields: [engineerId], references: [id])
  client   User            @relation(fields: [clientId], references: [id])
}